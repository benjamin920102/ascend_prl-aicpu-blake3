/* Ascend vector consumer: fold cube partials and publish transcripts to GM.
 * A separate, batched AICPU task hashes the completed strip.
 */
#include "acl/acl.h"
#include "../src/pearl_pipeline.h"
#include "kernel_operator.h"

#ifndef NINNER
#define NINNER 1
#endif
#ifndef NFOLD
#define NFOLD 32
#endif
#ifndef BUFS
#define BUFS 4
#endif
#ifndef BACKOFF
#define BACKOFF 500
#endif
#ifndef VEC2X
#define VEC2X 2  // Vec consumers per cube producer; BUFS must be divisible by VEC2X.
#endif

constexpr int32_t R = 128, BN = 64, KSTEP = 128;
constexpr int32_t NFOLD_C = NFOLD;
constexpr int32_t MM_N = R;
constexpr int32_t GRID = PEARL_GRID;
static_assert(BUFS >= 2, "one-band-late publication requires at least two buffers");
static_assert(VEC2X >= 1, "VEC2X must be positive");
static_assert(BACKOFF >= 0, "BACKOFF must be nonnegative");
constexpr int32_t PART_ELEMS = BN * R;
constexpr int32_t SLOT_ELEMS = PART_ELEMS;
constexpr int32_t WORDS = 16, ROT = 13;
constexpr int32_t FSTRIDE = 128;                     // isolate hot flags on 512B GM regions

__aicore__ inline uint64_t Slot(int32_t lc, int32_t buf, int32_t p)
{
    return (((uint64_t)lc * BUFS + buf) * NFOLD_C + p) * SLOT_ELEMS;
}

// Producer/consumer flags need explicit cache flushes and invalidation on GM.
__aicore__ inline void FlagStore(__gm__ volatile int32_t* p, int32_t v)
{
    *p = v;
    dcci((__gm__ int32_t*)p, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
}
__aicore__ inline void FlagSpinGE(__gm__ volatile int32_t* p, int32_t v)
{
    // Start with a short poll interval for near-ready buffers; BACKOFF remains
    // the cap for sustained waits. Every poll still refreshes the GM cache line.
    int32_t delay = BACKOFF < 8 ? BACKOFF : 8;
    while (true) {
        dcci((__gm__ int32_t*)p, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
        if (*p >= v) break;
        for (volatile int32_t i = 0; i < delay; ++i) {}
        if (delay < BACKOFF) delay = delay > BACKOFF / 2 ? BACKOFF : delay * 2;
    }
}

// XOR = (a | b) - (a & b): three vector ops instead of four.
// AND is a bitwise subset of OR, so each 16-bit subtraction has no borrow
// between halves and is also representable as int16_t (no signed overflow).
// dav-2201 supports int16 Sub; do not use the newer native Xor intrinsic.
__aicore__ inline void XorVec(const AscendC::LocalTensor<uint32_t>& dst,
    const AscendC::LocalTensor<uint32_t>& a, const AscendC::LocalTensor<uint32_t>& b,
    const AscendC::LocalTensor<uint32_t>& t0, const AscendC::LocalTensor<uint32_t>& t1, int32_t count)
{
    auto D = dst.ReinterpretCast<uint16_t>(); auto A = a.ReinterpretCast<uint16_t>();
    auto B = b.ReinterpretCast<uint16_t>();   auto T0 = t0.ReinterpretCast<uint16_t>();
    auto T1 = t1.ReinterpretCast<uint16_t>();
    int32_t c = count * 2;
    AscendC::Or(T0, A, B, c); AscendC::And(T1, A, B, c);
    auto DS = D.ReinterpretCast<int16_t>();
    auto U = T0.ReinterpretCast<int16_t>(); auto V = T1.ReinterpretCast<int16_t>();
    AscendC::Sub(DS, U, V, c);
}

__global__ __vector__ void pearl_hlc2_vec(__gm__ uint8_t* part, __gm__ uint8_t* trans,
    __gm__ int32_t* prodF, __gm__ int32_t* consF, int32_t nbands, int32_t gridDim, int32_t doFold,
    int32_t strip)
{
    const int32_t lc = AscendC::GetBlockIdx() % GRID;
    const int32_t sub = AscendC::GetBlockIdx() / GRID;
    if (AscendC::GetBlockIdx() >= GRID * VEC2X) return;
    // Each consumer follows its cube producer's per-lane monotonic flags.
    const int32_t iterBase = strip * ((nbands - lc + gridDim - 1) / gridDim);
    AscendC::GlobalTensor<int32_t> partG; partG.SetGlobalBuffer((__gm__ int32_t*)part);
    AscendC::GlobalTensor<uint32_t> trG;
    trG.SetGlobalBuffer((__gm__ uint32_t*)trans);
    __gm__ volatile int32_t* prod = (__gm__ volatile int32_t*)prodF;
    __gm__ volatile int32_t* cons = (__gm__ volatile int32_t*)consF;

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> partialQ;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> transcriptQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> accB, foldB, temp0B, temp1B;
    // Buffer count (2), rather than queue depth, enables double buffering.
    pipe.InitBuffer(partialQ, 2, PART_ELEMS * sizeof(int32_t));
    pipe.InitBuffer(accB, PART_ELEMS * sizeof(int32_t));
    pipe.InitBuffer(foldB, (PART_ELEMS / 2) * sizeof(uint32_t));
    // Two output buffers protect UB reuse while MTE3 writes the previous band.
    pipe.InitBuffer(transcriptQ, 2, WORDS * BN * sizeof(uint32_t));
    pipe.InitBuffer(temp0B, (BN / 2) * MM_N * sizeof(uint32_t));
    pipe.InitBuffer(temp1B, (BN / 2) * MM_N * sizeof(uint32_t));
    auto acc = accB.Get<int32_t>();
    auto buf2 = foldB.Get<uint32_t>();
    auto s0 = temp0B.Get<uint32_t>();
    auto s1 = temp1B.Get<uint32_t>();
    auto accU = acc.ReinterpretCast<uint32_t>();

    const int32_t releaseEvent = static_cast<int32_t>(
        pipe.FetchEventID(AscendC::HardEvent::MTE2_S));
    bool prefetched = false;
    int32_t iter = sub;
    for (int32_t band = lc + sub * gridDim; band < nbands; band += gridDim * VEC2X, iter += VEC2X) {
        const int32_t buf = (iterBase + iter) % BUFS;
        const int32_t f = (lc * BUFS + buf) * FSTRIDE;
        FlagSpinGE(&prod[f], iterBase + iter + 1);
        auto tr = transcriptQ.AllocTensor<uint32_t>();
        AscendC::Duplicate(acc, 0, PART_ELEMS);
        AscendC::Duplicate(tr, (uint32_t)0, WORDS * BN);
        AscendC::PipeBarrier<PIPE_V>();
        if (!prefetched) {
            auto first = partialQ.AllocTensor<int32_t>();
            AscendC::DataCopy(first, partG[Slot(lc, buf, 0)], PART_ELEMS);
            partialQ.EnQue(first);
        }
        prefetched = false;
        for (int32_t p = 0; p < NFOLD_C; ++p) {
            // EnQue/DeQue synchronize MTE2 -> V; FreeTensor protects reuse.
            auto partL = partialQ.DeQue<int32_t>();
            if (p + 1 < NFOLD_C) {
                auto next = partialQ.AllocTensor<int32_t>();
                AscendC::DataCopy(next, partG[Slot(lc, buf, p + 1)], PART_ELEMS);
                partialQ.EnQue(next);
            }
            if (p + 1 == NFOLD_C) {
                // The final partial is now in private UB. Wait for all GM reads
                // before allowing cube to overwrite this ring slot. Remaining
                // Add/fold/export work uses UB, not the shared GM partials.
                AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(releaseEvent);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(releaseEvent);
                FlagStore(&cons[f], iterBase + iter + 1);
            }
            AscendC::Add(acc, acc, partL, PART_ELEMS);
            partialQ.FreeTensor(partL);
            AscendC::PipeBarrier<PIPE_V>();
            if (!doFold) continue;
            // Folding starts from acc; buf2 receives the result without
            // modifying the running accumulator.
            XorVec(buf2, accU, accU[(BN / 2) * MM_N], s0, s1, (BN / 2) * MM_N);
            AscendC::PipeBarrier<PIPE_V>();
            for (int32_t half = BN / 4; half >= 1; half >>= 1) {
                XorVec(buf2, buf2, buf2[half * MM_N], s0, s1, half * MM_N);
                AscendC::PipeBarrier<PIPE_V>();
            }
            XorVec(s0, buf2, buf2[32], s1, s1[32], 32);
            XorVec(s0[32], buf2[64], buf2[96], s1, s1[32], 32);
            AscendC::PipeBarrier<PIPE_V>();
            int32_t idx = p % WORDS;
            AscendC::LocalTensor<uint32_t> word = tr[idx * BN];
            AscendC::ShiftLeft(s1, word, (uint32_t)ROT, BN);
            AscendC::ShiftRight(buf2, word, (uint32_t)(32 - ROT), BN);
            {
                auto S1 = s1.ReinterpretCast<uint16_t>();
                auto BUF = buf2.ReinterpretCast<uint16_t>();
                AscendC::Or(S1, S1, BUF, BN * 2);
            }
            XorVec(word, s1, s0, buf2, buf2[BN], BN);
            AscendC::PipeBarrier<PIPE_V>();
        }
        if (!doFold) {
            // Preserve the diagnostic transcript ABI: export the accumulator prefix.
            auto dst16 = tr.ReinterpretCast<uint16_t>();
            auto src16 = accU.ReinterpretCast<uint16_t>();
            AscendC::Or(dst16, src16, src16, WORDS * BN * 2);
        }
        // Keep the existing fold barriers. The output queue also establishes
        // V -> MTE3 ordering and prevents the next band from reusing live UB.
        AscendC::PipeBarrier<PIPE_ALL>();
        transcriptQ.EnQue(tr);
        auto out = transcriptQ.DeQue<uint32_t>();
        AscendC::DataCopy(trG[(uint64_t)band * WORDS * BN], out, WORDS * BN);
        transcriptQ.FreeTensor(out);

        // Opportunistic look-ahead: never wait for cube here. If the next
        // assigned band is ready, stage its first partial while MTE3 exports
        // this band. DeQue next iteration fences the copy; the future slot
        // is not released until all of its partials have been read.
        const int32_t nextIter = iter + VEC2X;
        if (band + gridDim * VEC2X < nbands) {
            const int32_t nextBuf = (iterBase + nextIter) % BUFS;
            const int32_t nextFlag = (lc * BUFS + nextBuf) * FSTRIDE;
            dcci((__gm__ int32_t*)&prod[nextFlag], cache_line_t::SINGLE_CACHE_LINE,
                 dcci_dst_t::CACHELINE_OUT);
            if (prod[nextFlag] >= iterBase + nextIter + 1) {
                auto next = partialQ.AllocTensor<int32_t>();
                AscendC::DataCopy(next, partG[Slot(lc, nextBuf, 0)], PART_ELEMS);
                partialQ.EnQue(next);
                prefetched = true;
            }
        }

    }
    // The host records the fold-ready event only after every GM export completes.
    AscendC::PipeBarrier<PIPE_ALL>();
}

extern "C" void LaunchVec(void* part, void* trans, void* prodF, void* consF,
                          int32_t nbands, int32_t gridDim, int32_t doFold, int32_t strip, void* stream)
{
    pearl_hlc2_vec<<<GRID * VEC2X, nullptr, (aclrtStream)stream>>>((uint8_t*)part, (uint8_t*)trans,
        (int32_t*)prodF, (int32_t*)consF, nbands, gridDim, doFold, strip);
}
